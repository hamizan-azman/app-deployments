# khoj environment configuration
# Copy this file to .env and fill in required values before running docker compose up -d

# =============================================================================
# PORTS
# =============================================================================
KHOJ_PORT=42110

# =============================================================================
# POSTGRES
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=postgres

# =============================================================================
# KHOJ SERVER
# =============================================================================
KHOJ_DJANGO_SECRET_KEY=change-me-in-production
KHOJ_ADMIN_EMAIL=admin@example.com
KHOJ_ADMIN_PASSWORD=change-me-in-production

# =============================================================================
# LLM API KEYS (at least one required for AI chat features)
# =============================================================================
# OPENAI_API_KEY=your_openai_api_key
# GEMINI_API_KEY=your_gemini_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# =============================================================================
# OPTIONAL: LOCAL OLLAMA
# Uncomment if running Ollama on the host machine
# =============================================================================
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1/
# KHOJ_DEFAULT_CHAT_MODEL=qwen3

# =============================================================================
# OPTIONAL: WEB SEARCH API KEYS
# =============================================================================
# SERPER_DEV_API_KEY=your_serper_dev_api_key
# FIRECRAWL_API_KEY=your_firecrawl_api_key
# EXA_API_KEY=your_exa_api_key

# =============================================================================
# OPTIONAL: PUBLIC ACCESS
# Uncomment and set if making Khoj publicly accessible
# =============================================================================
# KHOJ_NO_HTTPS=True
# KHOJ_DOMAIN=your-server-ip-or-domain
# KHOJ_TELEMETRY_DISABLE=True
