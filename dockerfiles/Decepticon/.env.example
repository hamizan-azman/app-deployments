# =============================================================================
# Decepticon — Required Environment Variables
# Copy this file to .env and fill in values before running docker compose up.
# =============================================================================

# --- LLM API Keys (required: at least one) ---
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
# GOOGLE_API_KEY=your-google-key-here

# --- LiteLLM Proxy (required) ---
# These protect the internal LiteLLM proxy. Change both from the defaults.
LITELLM_MASTER_KEY=sk-decepticon-master-change-me
LITELLM_SALT_KEY=sk-decepticon-salt-change-me

# --- PostgreSQL (required) ---
POSTGRES_PASSWORD=decepticon-change-me

# --- Model Profile ---
# eco  = balanced Opus/Sonnet/Haiku mix (recommended)
# max  = Opus everywhere (expensive)
# test = Haiku-only (cheapest, for development)
DECEPTICON_MODEL_PROFILE=eco

# --- C2 Framework (required for C2 to start) ---
# Activates the c2-sliver profile so the Sliver C2 server starts with compose up.
# Remove or leave blank to skip C2 startup.
COMPOSE_PROFILES=c2-sliver

# --- Workspace Path (required) ---
# Absolute path to the Decepticon home directory.
# This directory is bind-mounted into the sandbox container as /workspace.
# Do NOT use ~ (tilde). Docker Compose cannot expand it.
DECEPTICON_HOME=/home/youruser/.decepticon

# --- Ports (optional, uncomment to override defaults) ---
# LANGGRAPH_PORT=2024
# LITELLM_PORT=4000
# POSTGRES_PORT=5432

# --- LangSmith Tracing (optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key-here
# LANGSMITH_PROJECT=decepticon

# --- Debug (optional) ---
# DECEPTICON_DEBUG=true
