# Onyx environment configuration
# Copy this file to .env and fill in required values before running docker compose
# Usage: docker compose --profile s3-filestore up -d
# To use postgres file storage instead: docker compose up -d (no profile)
#   and set FILE_STORE_BACKEND=postgres

# =============================================================================
# IMAGE VERSION
# =============================================================================
IMAGE_TAG=latest

# =============================================================================
# AUTH
# =============================================================================
# Options: basic, google_oauth, oidc, saml, disabled
AUTH_TYPE=basic
# Required for basic auth (generate with: openssl rand -hex 32)
USER_AUTH_SECRET=change-me-in-production

# =============================================================================
# POSTGRES
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production

# =============================================================================
# OPENSEARCH
# =============================================================================
OPENSEARCH_ADMIN_PASSWORD=StrongPassword123!
OPENSEARCH_FOR_ONYX_ENABLED=true

# =============================================================================
# FILE STORAGE
# =============================================================================
# s3 = MinIO (default, requires --profile s3-filestore)
# postgres = no extra services needed
COMPOSE_PROFILES=s3-filestore
FILE_STORE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_AWS_ACCESS_KEY_ID=minioadmin
S3_AWS_SECRET_ACCESS_KEY=minioadmin
S3_FILE_STORE_BUCKET_NAME=onyx-file-store-bucket
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# =============================================================================
# INTERNAL SERVICE ADDRESSES (do not change for default Docker networking)
# =============================================================================
POSTGRES_HOST=relational_db
VESPA_HOST=index
REDIS_HOST=cache
MODEL_SERVER_HOST=inference_model_server
INDEXING_MODEL_SERVER_HOST=indexing_model_server
INTERNAL_URL=http://api_server:8080

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_ONYX_MODEL_INTERACTIONS=False

# =============================================================================
# LLM API KEYS (required for AI features)
# =============================================================================
# GEN_AI_API_KEY=your_api_key

# =============================================================================
# OPTIONAL: GOOGLE OAUTH
# =============================================================================
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# =============================================================================
# OPTIONAL: SMTP (for email verification and invites)
# =============================================================================
# SMTP_SERVER=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# =============================================================================
# ENTERPRISE (requires paid plan)
# =============================================================================
ENABLE_PAID_ENTERPRISE_EDITION_FEATURES=false
